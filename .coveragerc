[run]
omit =
    **/interface.py
    **/interfaces.py
    *migrations/*
    debug_*.py
    *site-packages/*
    manage.py
    marketplace/settings.py
    *tests/*
    marketplace/flows/*
    marketplace/connect/*
    marketplace/clients/*
    marketplace/interfaces/*
    *urls.py*

[report]
fail_under = 75
